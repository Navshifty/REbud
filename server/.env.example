# Copy to .env and adjust. Never commit .env.

# Port the API listens on
PORT=4000

# Origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWTs — use a long random string in real deployments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the JSON-file store and uploaded documents live (relative to server/)
DATA_DIR=data
UPLOAD_DIR=uploads

# Simulated latency for mock analysis jobs, in milliseconds
MOCK_ANALYSIS_MS=1400
