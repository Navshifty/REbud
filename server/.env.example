# Copy to .env and adjust. Never commit .env.

# Port the API listens on
PORT=4000

# Origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWTs — use a long random string in real deployments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the JSON-file store and uploaded documents live (relative to server/)
DATA_DIR=data
UPLOAD_DIR=uploads

# Simulated latency for sample (mock) analysis jobs, in milliseconds
MOCK_ANALYSIS_MS=1400

# --- Research-intelligence pipeline -------------------------------------
# Claude API key. Leave empty to serve labelled sample results instead of
# calling the model. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model and reasoning effort for analysis (low | medium | high | xhigh | max)
ANTHROPIC_MODEL=claude-opus-5
ANALYSIS_EFFORT=high

# Let the "Related research" module verify papers with Claude's web search
# tool (costs extra per search). Off by default.
ENABLE_WEB_SEARCH=false

# Document text handed to the model per request; larger corpora are
# narrowed with retrieval. Chunk size for retrieval/evidence.
MAX_CONTEXT_CHARS=160000
CHUNK_CHARS=1800
