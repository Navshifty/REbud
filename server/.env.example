# Copy to .env and adjust. Never commit .env.

# Port the API listens on
PORT=4000

# Origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWTs — use a long random string in real deployments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MongoDB connection. Defaults to a local server on the standard port.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rebud

# Legacy JSON data (read only by scripts/migrate-json-to-mongo.js), and
# where uploaded documents are stored. Relative to server/
DATA_DIR=data
UPLOAD_DIR=uploads

# Simulated latency for sample (mock) analysis jobs, in milliseconds
MOCK_ANALYSIS_MS=1400

# --- Research-intelligence pipeline -------------------------------------
# Which provider runs the analysis: gemini | anthropic.
# Leave the selected provider's key empty to serve labelled sample
# results instead of calling a model.
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com -> Get API key.
# Note: Pro models have a free-tier quota of 0 and need billing enabled
# on the Cloud project. Flash models work on the free tier.
# Model ids retire — if you get a 404 naming a replacement, use that.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Claude API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Reasoning depth for analysis (low | medium | high | xhigh | max)
ANALYSIS_EFFORT=high

# Let the "Related research" module verify papers with the provider's
# web-search tool (costs extra per search). Off by default.
ENABLE_WEB_SEARCH=false

# Document text handed to the model per request; larger corpora are
# narrowed with retrieval. Chunk size for retrieval/evidence.
MAX_CONTEXT_CHARS=160000
CHUNK_CHARS=1800
